{
  "name": "@piensa-it/illustrations",
  "description": "Catálogo compartido de ilustraciones de Piensa IT para aplicaciones, documentación y material de apoyo.",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/illustrations.cjs.js",
  "module": "./dist/illustrations.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/illustrations.es.js",
      "require": "./dist/illustrations.cjs.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@piensa-it"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.5.3",
    "globals": "^15.15.0",
    "jsdom": "^29.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.4"
  }
}
